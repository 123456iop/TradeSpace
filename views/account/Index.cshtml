@model TradeSpace.Models.User
@{ ViewData["Title"] = "Особистий кабінет"; }

<div class="container mt-4">
    <h1 class="mb-4">Привіт, @Model.FirstName!</h1>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Мої дані</h5>
                </div>
                <div class="card-body">
                    <p><strong>Ім'я:</strong> @Model.FirstName @Model.LastName</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Дата реєстрації:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy")</p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Історія замовлень</h5>
                </div>
                <div class="card-body">
                    @if (Model.Orders.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var order in Model.Orders.OrderByDescending(o => o.CreatedAt))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>Замовлення від @order.CreatedAt.ToString("dd.MM.yyyy")</span>
                                    <span class="badge bg-success rounded-pill">@order.TotalAmount.ToString("C")</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">У вас ще немає замовлень.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>