@model TradeSpace.Models.User

@{
    ViewData["Title"] = "Личный кабинет";
}

@if (Model == null)
{
    <div class="alert alert-danger">
        Данные пользователя не найдены. Пожалуйста, войдите снова.
    </div>
}
else
{
    <div class="container mt-4">
        <h2>Личный кабинет</h2>
        <hr />

        <div class="card mb-4">
            <div class="card-body">
                <h4 class="card-title">@Model.FirstName @Model.LastName</h4>
                <p class="card-text"><strong>Email:</strong> @Model.Email</p>
                <p class="card-text"><strong>Телефон:</strong> @(Model.PhoneNumber ?? "Не указан")</p>
                <p class="card-text"><strong>Роль:</strong> @Model.Role</p>
                <p class="card-text"><small class="text-muted">Зарегистрирован: @Model.CreatedAt.ToString("dd.MM.yyyy")</small></p>
            </div>
        </div>

        @if (Model.Role == TradeSpace.Models.UserRole.Admin)
        {
            <div class="card mb-4 border-danger">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-1">Панель администратора</h5>
                        <p class="card-text text-muted mb-0">Просмотр пользователей и управление их ролями</p>
                    </div>
                    <a asp-controller="Admin" asp-action="Users" class="btn btn-danger">Управлять ролями</a>
                </div>
            </div>
        }

        <h3>Мои магазины</h3>
        @if (Model.Stores != null && Model.Stores.Any())
        {
            <ul class="list-group mb-4">
                @foreach (var store in Model.Stores)
                {
                    <li class="list-group-item">
                        <strong>@store.Name</strong> — @store.Description
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">У вас пока нет созданных магазинов.</p>
        }

        <h3>Мои заказы</h3>
        @if (Model.Orders != null && Model.Orders.Any())
        {
            <ul class="list-group">
                @foreach (var order in Model.Orders)
                {
                    <li class="list-group-item">
                        Заказ №@order.Id — Сумма: @order.TotalAmount | Статус: @order.Status
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">История заказов пуста.</p>
        }
    </div>
}