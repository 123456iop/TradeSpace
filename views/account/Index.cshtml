@model TradeSpace.Models.User
@{
    ViewData["Title"] = "Особистий кабінет";
    var orders = ViewBag.Orders as List<TradeSpace.Models.Order> ?? new List<TradeSpace.Models.Order>();
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <h1 class="mb-4">Привіт, @Model.FirstName!</h1>

    <div class="row">
        <!-- Блок профілю -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Мої дані</h5>
                </div>
                <div class="card-body">
                    <p><strong>Ім'я:</strong> @Model.FirstName @Model.LastName</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Телефон:</strong> @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Не вказано" : Model.PhoneNumber)</p>
                    <p><strong>Реєстрація:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy")</p>
                    
                    <hr />
                    <div class="d-grid gap-2">
                        <a asp-action="EditProfile" class="btn btn-outline-primary btn-sm">Редагувати профіль</a>
                        <a asp-action="ChangePassword" class="btn btn-outline-secondary btn-sm">Змінити пароль</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Історія замовлень -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Історія замовлень</h5>
                </div>
                <div class="card-body">
                    @if (orders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>№ Замовлення</th>
                                        <th>Дата</th>
                                        <th>Сума</th>
                                        <th>Статус</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in orders)
                                    {
                                        <tr>
                                            <td><small class="text-muted">#@order.Id.ToString().Substring(0, 8)</small></td>
                                            <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td><strong>@order.TotalAmount.ToString("C")</strong></td>
                                            <td>
                                                @switch (order.Status)
                                                {
                                                    case TradeSpace.Models.OrderStatus.Pending:
                                                        <span class="badge bg-warning text-dark">Очікує</span>
                                                        break;
                                                    case TradeSpace.Models.OrderStatus.Paid:
                                                        <span class="badge bg-info">Оплачено</span>
                                                        break;
                                                    case TradeSpace.Models.OrderStatus.Shipped:
                                                        <span class="badge bg-primary">Відправлено</span>
                                                        break;
                                                    case TradeSpace.Models.OrderStatus.Delivered:
                                                        <span class="badge bg-success">Доставлено</span>
                                                        break;
                                                    case TradeSpace.Models.OrderStatus.Cancelled:
                                                        <span class="badge bg-danger">Скасовано</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@order.Status</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="OrderDetail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark">Деталі</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">У вас ще немає замовлень.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>