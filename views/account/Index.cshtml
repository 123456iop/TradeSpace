@model TradeSpace.Models.User
@using TradeSpace.Models

@{
    ViewData["Title"] = "Особистий кабінет";
}

<div class="container mt-4">
    <h2>Особистий кабінет</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="mb-4">
        <h4><strong>@Model.FirstName @Model.LastName</strong></h4>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Номер телефону:</strong> @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Не вказано" : Model.PhoneNumber)</p>
        <p><strong>Роль:</strong> @Model.Role</p>
        <p><strong>Зареєстрований:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy")</p>

        <div class="mt-3">
            <a asp-action="EditProfile" class="btn btn-outline-primary btn-sm">Змінити ім'я</a>
            <a asp-action="ChangePassword" class="btn btn-outline-secondary btn-sm">Змінити пароль</a>

            @if (Model.Role == UserRole.Admin)
            {
                <a asp-controller="Admin" asp-action="Users" class="btn btn-danger btn-sm ms-2">Управління користувачами</a>
                <a asp-controller="Admin" asp-action="Tickets" class="btn btn-warning btn-sm ms-2">Всі тікети</a>
            }
            else
            {
                <a asp-controller="Support" asp-action="Index" class="btn btn-outline-info btn-sm ms-2">Підтримка (Чат з адміном)</a>
            }
        </div>
    </div>

    <hr />

    <div class="mb-4">
        <h4>Мої магазини</h4>
        @if (Model.Role == UserRole.Seller || Model.Role == UserRole.Admin)
        {
            <div class="mt-2 mb-2 d-flex gap-2">
                <a asp-controller="Store" asp-action="Create" class="btn btn-success">Створити магазин</a>
                <a asp-controller="Products" asp-action="Manage" class="btn btn-primary">Управління товарами</a>
            </div>
            <p class="text-muted small">Якщо ви ще не зареєстрували магазин, натисніть "Створити магазин". Тільки після цього ви зможете додавати категорії та товари.</p>
        }
        else
        {
            <p class="text-muted">Щоб створити магазин, ви повинні мати статус продавця.</p>
        }
    </div>

    <div class="mb-4">
        <h4>Мої замовлення</h4>
        <p class="text-muted">Історія замовлень порожня.</p>
    </div>
</div>