@model TradeSpace.Models.SupportTicket
@using System.Security.Claims

@{
    ViewData["Title"] = "Тикет: " + Model.Subject;
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<div class="container mt-4">
    <h2>@Model.Subject</h2>
    <p class="text-muted">Користувач: @Model.User?.Email | Створено: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
    <hr />

    <div class="chat-box mb-4 p-3 border rounded bg-light" style="max-height: 400px; overflow-y: auto;">
        @foreach (var msg in Model.Messages.OrderBy(m => m.SentAt))
        {
            var isAdmin = msg.SenderId.ToString() == currentUserId;
            <div class="mb-3 @(isAdmin ? "text-end" : "text-start")">
                <div class="d-inline-block p-2 rounded @(isAdmin ? "bg-primary text-white" : "bg-white border")" style="max-width: 75%; text-align: left;">
                    <strong>@(isAdmin ? "Адміністратор" : (msg.Sender?.FirstName ?? "Користувач"))</strong><br />
                    <span>@msg.Text</span>
                    <div class="@(isAdmin ? "text-white-50" : "text-muted")" style="font-size: 0.75rem;">@msg.SentAt.ToString("HH:mm")</div>
                </div>
            </div>
        }
    </div>

    @if (!Model.IsClosed)
    {
        <form asp-action="ReplyTicket" method="post" class="mb-3">
            <input type="hidden" name="ticketId" value="@Model.Id" />
            <div class="input-group">
                <textarea name="message" class="form-control" placeholder="Введіть відповідь..." rows="2" required></textarea>
                <button type="submit" class="btn btn-primary">Відправити</button>
            </div>
        </form>

        <form asp-action="CloseTicket" method="post">
            <input type="hidden" name="ticketId" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Закрити це звернення?');">Закрити звернення</button>
        </form>
    }
    else
    {
        <div class="alert alert-secondary">Це звернення закрито адміністратором.</div>
    }
    
    <div class="mt-3">
        <a asp-action="Tickets" class="btn btn-outline-secondary btn-sm">Повернутися до списку тікетів</a>
    </div>
</div>