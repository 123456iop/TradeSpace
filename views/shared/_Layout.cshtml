<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TradeSpace</title>
    <!-- Підключення стилів -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav>
        <div class="logo">
            <a href="/">TradeSpace</a>
        </div>
        <div class="menu">
            <!-- Посилання на сторінку товарів та кошик -->
            <a asp-controller="Products" asp-action="Index">Каталог</a>
            <a asp-controller="Cart" asp-action="Index">Кошик</a>
            
            <!-- Динамічні посилання для авторизації -->
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Index">Кабінет (@User.Identity.Name)</a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                    <button type="submit" style="background:none; border:none; cursor:pointer; color:inherit; font:inherit; text-decoration:underline;">Вийти</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Увійти</a>
                <a asp-controller="Account" asp-action="Register">Реєстрація</a>
            }
        </div>
    </nav>
</header>

<main role="main" class="container">
    <!-- Саме сюди буде підставлятися код конкретних сторінок (Index, Details тощо) -->
    @RenderBody() 
</main>

<footer>
    <p>&copy; @DateTime.Now.Year - TradeSpace. Всі права захищено.</p>
</footer>

<!-- Секція для підключення додаткових скриптів на окремих сторінках -->
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>