@model IEnumerable<TradeSpace.Models.SupportTicket>
@{ ViewData["Title"] = "Підтримка"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@(User.IsInRole("Admin") ? "Всі звернення (Адмін)" : "Мої звернення")</h2>
        @if (!User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success">Написати у підтримку</a>
        }
    </div>

    <table class="table table-hover">
        <thead>
        <tr>
            <th>Тема</th>
            @if (User.IsInRole("Admin")) { <th>Користувач</th> }
            <th>Останнє оновлення</th>
            <th>Дії</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Subject</td>
                @if (User.IsInRole("Admin")) { <td>@ticket.User?.Email</td> }
                <td>@ticket.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary">Відкрити чат</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>