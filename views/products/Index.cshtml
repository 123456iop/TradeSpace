@model IEnumerable<TradeSpace.Models.Product>
@using System.Linq

@{
    ViewData["Title"] = "Каталог товарів";
}

<h1>Каталог TradeSpace</h1>

<div class="products-grid">
    @foreach (var item in Model)
    {
        <div class="product-card">
            @* Вывод главного изображения товара *@
            @{
                var mainImg = item.Images?.FirstOrDefault(i => i.IsMain)?.Url ?? "/img/no-image.png";
            }
            <img src="@mainImg" alt="@item.Title" style="max-width: 100%; height: auto;" />

            <h3>@item.Title</h3>

            @* Информация о категории и магазине *@
            <p class="text-muted">
                Категорія: @(item.Category?.Name ?? "Не вказано") <br/>
                Магазин: @(item.Store?.Name ?? "TradeSpace")
            </p>

            <p class="price"><strong>@item.Price.ToString("C")</strong></p>

            @* Проверка наличия на складе *@
            @if (item.StockQuantity > 0)
            {
                <p class="stock text-success">В наявності: @item.StockQuantity шт.</p>
                
                <div class="actions">
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary">
                        Детальніше
                    </a>

                    <form asp-controller="Cart" asp-action="Add" method="post" style="display:inline-block;">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <input type="number" name="quantity" value="1" min="1" max="@item.StockQuantity" style="width: 60px;" />
                        <button type="submit" class="btn btn-primary">В кошик</button>
                    </form>
                </div>
            }
            else
            {
                <p class="stock text-danger">Немає в наявності</p>
                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary">
                    Детальніше
                </a>
            }
        </div>
    }
</div>