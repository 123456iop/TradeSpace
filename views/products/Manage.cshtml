@model IEnumerable<TradeSpace.Models.Product>
@{ ViewData["Title"] = "Управління товарами"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Управління товарами</h2>
        <div>
            <a asp-action="Create" class="btn btn-success">+ Додати товар</a>
            <a asp-controller="Account" asp-action="Index" class="btn btn-outline-secondary ms-2">В кабінет</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">У вашому магазині ще немає товарів.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle shadow-sm bg-white rounded">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Фото</th>
                        <th>Назва</th>
                        <th>Ціна</th>
                        <th>Залишок</th>
                        <th>Статус</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)" 
                                     alt="@item.Title" 
                                     style="width: 50px; height: 50px; object-fit: cover;" 
                                     class="rounded border" />
                            </td>
                            <td>
                                <strong>@item.Title</strong><br />
                                <small class="text-muted">@item.Category?.Name</small>
                            </td>
                            <td>@item.Price.ToString("N2") грн</td>
                            <td>@item.StockQuantity шт.</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Активний</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Прихований</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Редагувати</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Видалити цей товар?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>