@model TradeSpace.Models.Category

@{
    ViewData["Title"] = "Створення нової категорії";
}

<div class="container mt-4">
    <h2>Створення нової категорії</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="CreateCategory" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label fw-bold">Назва категорії</label>
                    <input asp-for="Name" class="form-control" placeholder="Наприклад: Електроніка" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Slug" class="control-label fw-bold">URL-посилання (Slug)</label>
                    <input asp-for="Slug" class="form-control" placeholder="Наприклад: elektronika (необов'язково)" />
                    <small class="form-text text-muted">Залиште порожнім, і система згенерує його автоматично з назви.</small>
                    <span asp-validation-for="Slug" class="text-danger"></span>
                </div>

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Зберегти категорію</button>
                    <a asp-action="Manage" class="btn btn-secondary">Скасувати</a>
                </div>
            </form>
        </div>
    </div>
</div>